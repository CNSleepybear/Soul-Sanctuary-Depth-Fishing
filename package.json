{
  "name": "soul-sanctuary",
  "version": "0.1.0",
  "description": "Desktop Fishing Roguelike Widget — cast lines into pixelated sanctuaries",
  "main": "dist/main/index.js",
  "author": "Soul Sanctuary",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:vite && electron .",
    "build:vite": "vite build",
    "build": "npm run build:vite && electron-builder",
    "build:win": "npm run build:vite && electron-builder --win",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "npx playwright test tests/unit.spec.ts",
    "test:smoke": "npx playwright test tests/smoke.spec.ts --project=electron",
    "test:smoke:headed": "npx playwright test tests/smoke.spec.ts --project=electron --headed"
  },
  "dependencies": {
    "@fontsource/vt323": "^5.2.7",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.4",
    "sharp": "^0.35.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
